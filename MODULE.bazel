module(
    name = "kubevirt",
    version = "0.0.0",
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "package_metadata", version = "0.0.7")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_img", version = "0.3.9")
bazel_dep(name = "hermetic_launcher", version = "0.0.15")
bazel_dep(name = "buildifier_prebuilt", version = "8.2.1.2")
bazel_dep(name = "rules_go", version = "0.60.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.50.0", repo_name = "bazel_gazelle")
bazel_dep(name = "bazeldnf", version = "0.7.0")

# WIP(DO NOT MERGE): Pull bazeldnf from rmohr/bazeldnf#199 and compile its
# toolchain from source until v0.7.0 is tagged and published.
git_override(
    module_name = "bazeldnf",
    commit = "de0b98161b9245bd8600a626e7fa43b5aa77755f",
    remote = "https://github.com/rmohr/bazeldnf.git",
)

bazeldnf_toolchain = use_extension("@bazeldnf//bazeldnf:extensions.bzl", "bazeldnf_toolchain")
bazeldnf_toolchain.register(disable = True)

register_toolchains("@bazeldnf//cmd:bazeldnf-host-toolchain")

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.10")
go_sdk.nogo(nogo = "//:nogo_vet")

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "@bazeldnf//:go.mod")
go_deps.gazelle_override(
    build_file_generation = "clean",
    directives = ["gazelle:proto disable_global"],
    path = "github.com/bazelbuild/buildtools",
)
use_repo(
    go_deps,
    "org_golang_x_crypto",
    "org_golang_x_net",
    "org_golang_x_text",
    "org_golang_x_tools",
)

bazeldnf_rpms = use_extension("@bazeldnf//bazeldnf:extensions.bzl", "bazeldnf")
bazeldnf_rpms.config(
    name = "kubevirt-rpms",
    ignore_deps = True,
    lock_file = "//:rpms.json",
)
use_repo(bazeldnf_rpms, "kubevirt-rpms")

register_toolchains("//:py_toolchain")

# Register KubeVirt custom C toolchains (CS10 more specific first, then CS9 defaults).
register_toolchains(
    "//bazel/toolchain/x86_64-none-linux-gnu:x86_64_linux_toolchain_cs10",
    "//bazel/toolchain/aarch64-none-linux-gnu:aarch64_linux_toolchain_cs10",
    "//bazel/toolchain/s390x-none-linux-gnu:s390x_linux_toolchain_cs10",
    "//bazel/toolchain/s390x-none-linux-gnu:s390x_linux_toolchain",
    "//bazel/toolchain/aarch64-none-linux-gnu:aarch64_linux_toolchain",
    "//bazel/toolchain/x86_64-none-linux-gnu:x86_64_linux_toolchain",
)

_http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

_http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

pull = use_repo_rule("@rules_img//img:pull.bzl", "pull")

_go_repository = use_repo_rule("@bazel_gazelle//:def.bzl", "go_repository")

