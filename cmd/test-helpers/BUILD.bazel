load("@rules_img//img:layer.bzl", "layer_from_tar")
load("@rules_pkg//:pkg.bzl", "pkg_tar")
load("//bazel:image.bzl", "kubevirt_image")

pkg_tar(
    name = "test-pod-mutator-tar",
    testonly = True,
    srcs = ["//cmd/test-helpers/pod-mutator:test-pod-mutator"],
    package_dir = "/usr/bin",
)

pkg_tar(
    name = "dra-test-driver-tar",
    testonly = True,
    srcs = ["//cmd/test-helpers/dra-test-driver/cmd:dra-test-driver"],
    package_dir = "/usr/bin",
)

layer_from_tar(
    name = "passt-tree-layer-x86_64",
    testonly = True,
    src = "//rpm:passt_tree_x86_64",
)

layer_from_tar(
    name = "passt-tree-layer-aarch64",
    testonly = True,
    src = "//rpm:passt_tree_aarch64",
)

layer_from_tar(
    name = "passt-tree-layer-s390x",
    testonly = True,
    src = "//rpm:passt_tree_s390x",
)

kubevirt_image(
    name = "version-container",
    testonly = True,
    base = "//images:kubevirt-testing-base",
    layers = select({
        "@io_bazel_rules_go//go/platform:linux_arm64": [
            ":passt-tree-layer-aarch64",
        ],
        "@io_bazel_rules_go//go/platform:linux_s390x": [
            ":passt-tree-layer-s390x",
        ],
        "//conditions:default": [
            ":passt-tree-layer-x86_64",
        ],
    }),
)

kubevirt_image(
    name = "test-helpers-image",
    testonly = True,
    base = ":version-container",
    tars = [
        ":test-pod-mutator-tar",
        ":dra-test-driver-tar",
    ],
    visibility = ["//visibility:public"],
)
