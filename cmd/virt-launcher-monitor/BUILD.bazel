load("@io_bazel_rules_go//go:def.bzl", "go_test")

cc_binary(
    name = "virt-launcher-monitor",
    srcs = ["main.c"],
    copts = [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    # The workspace goveralls merger expects Go profiles, not GCC/LCOV data.
    features = ["-coverage"],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "virt-launcher-monitor-test-binary",
    testonly = True,
    srcs = ["main.c"],
    copts = [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-DVIRT_LAUNCHER_MONITOR_TESTING",
    ],
    features = ["-coverage"],
)

go_test(
    name = "go_default_test",
    srcs = [
        "main_test.go",
        "virt_launcher_monitor_suite_test.go",
    ],
    args = [
        "--virt-launcher-monitor-binary",
        "$(location //cmd/virt-launcher-monitor:virt-launcher-monitor-test-binary)",
    ],
    data = [":virt-launcher-monitor-test-binary"],
    race = "on",
    deps = [
        "//staging/src/kubevirt.io/client-go/testutils:go_default_library",
        "//vendor/github.com/onsi/ginkgo/v2:go_default_library",
        "//vendor/github.com/onsi/gomega:go_default_library",
    ],
)
